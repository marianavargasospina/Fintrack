# Conexión a PostgreSQL (usar el rol de la app con RLS, nunca el superusuario)
DATABASE_URL=postgresql+psycopg://fintrack_app:TU_PASSWORD_AQUI@localhost:5432/fintrack

# Seguridad y Autenticación JWT
JWT_SECRET_KEY=cambiar-por-una-clave-secreta-aleatoria-y-segura-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configuración del Entorno
ENVIRONMENT=development

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
